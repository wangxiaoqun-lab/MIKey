+            elseif step == 17 && ~exist(MIKey_bids_path(anat,[base '_desc-gmvol.nii']),'file')
+                requireFile(MIKey_bids_path(anat,[base '_desc-scaled.nii'],'input'));
+                requireFile(MIKey_bids_path(anat,[base '_desc-masked.nii'],'input'));
+            end
+        end
+    end
+end
+end
