+        report=check(stage,phase{1},moving);
+        assert(strcmp(report.status,'passed'));
+    end
+end
+% Different voxel resolutions with the same physical object must pass.
+finer=a;finer(1:3,1:3)=diag([0.5 0.5 0.5]);
