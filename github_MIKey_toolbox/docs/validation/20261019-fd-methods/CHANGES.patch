+    fig.UserData.fdRadiusSetting.Value=cfg.fdRadius;
+    updateStatus(fig,sprintf('Step 10 FD settings: %s; rotation radius=%g (SPM image units).',cfg.fdMethod,cfg.fdRadius));
+catch ME
+    errordlg(ME.message,'Invalid FD Settings');
 end
 end
 
